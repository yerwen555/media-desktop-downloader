# 运行时生成（登录状态、下载记录、日志、下载文件都在这里，绝对不要提交）
data/
downloads/
config.json

# 可能包含 Cookie / 记录的本地文件
*.log
*.db
*.sqlite
*.sqlite3
*.part
*.tmp
.env

# 虚拟环境（含本地绝对路径与大量第三方包，绝不提交）
venv/
.venv/

# pip 在项目内留下的临时目录
pip-build-tracker-*/
pip-install-*/

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 开发临时脚本 / 发布产物
scratch/
dist/
release/
